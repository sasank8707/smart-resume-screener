# ============================================================
# Smart Resume Screener — example environment configuration
# Copy this file to `.env` (never commit `.env`) and fill in
# only the values you need.
# ============================================================

# ---------------- LLM provider ----------------
# Provider used for resume parsing enrichment and semantic matching.
# Allowed values:
#   mock      -> deterministic offline scorer (no API key needed, default)
#   openai    -> OpenAI or any OpenAI-compatible endpoint (Groq, Together, Ollama, ...)
#   anthropic -> Anthropic Claude via the Messages API
LLM_PROVIDER=mock

# OpenAI-compatible settings (also used by Groq/Together/Ollama/LM Studio)
OPENAI_API_KEY=
# Override for compatible endpoints, e.g. https://api.groq.com/openai/v1
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Anthropic settings (only required when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# LLM request behaviour
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# ---------------- Screening -----------------
# Default shortlist threshold on the 1-10 scale (configurable in the UI too)
SHORTLIST_THRESHOLD=7
# Maximum upload size per resume file, in megabytes
MAX_UPLOAD_SIZE_MB=10

# ---------------- Server --------------------
HOST=127.0.0.1
PORT=8000
# Comma-separated list of allowed browser origins (frontend dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------- Database ------------------
# Local development uses SQLite. For production use PostgreSQL, e.g.:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/smart_resume_screener
DATABASE_URL=sqlite:///./smart_resume_screener.db
